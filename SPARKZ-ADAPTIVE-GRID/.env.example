# Flat overrides for config/default.yaml. Leave a line out to keep the YAML value.
SYMBOL=XAUUSD
TIMEFRAME=15m
INITIAL_CAPITAL=10000
ENTRY_MODE=TREND
GRID_MODE=ATR
GRID_ATR_MULTIPLIER=0.5
MAX_POSITIONS=5
POSITION_SIZING=FIXED
BASE_LOT=0.01
RISK_PER_CYCLE=0.01
BASKET_TARGET_MODE=PERCENT
BASKET_TARGET_PERCENT=0.5
MAX_BASKET_LOSS_PERCENT=1.0
MAX_ACCOUNT_DRAWDOWN_PERCENT=10
MAX_DAILY_LOSS_PERCENT=3
COOLDOWN_BARS_AFTER_LOSS=8
ALLOW_MARTINGALE=false
PAPER_TRADING=true
# Version 1 has no broker connection. Setting this to true stops the app from starting.
LIVE_TRADING=false
