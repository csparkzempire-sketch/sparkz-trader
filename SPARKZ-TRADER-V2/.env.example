# SPARKZ TRADER V2 — example environment. Copy to .env and fill in locally. NEVER commit .env.
# Every value here is a placeholder; no real credential belongs in this file.

# ---- Safety (enforced: the app refuses to start with live trading enabled) ----
LIVE_TRADING_ENABLED=false
ENVIRONMENT=PAPER                  # DEVELOPMENT | BACKTEST | PAPER

# ---- Market data ----
MARKET_DATA_PROVIDER=MOCK          # MOCK | YAHOO | BROKER | BRIDGE | HISTORICAL
SYMBOL=XAUUSD
TIMEFRAME=15m
POLL_SECONDS=5
STALE_AFTER_SECONDS=120

# Broker market data (OANDA v20, READ-ONLY: pricing, candles, instrument details; no orders).
# A practice-account token is enough. Leave empty unless MARKET_DATA_PROVIDER=BROKER.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice         # practice | live (still market data only)

# MT5 bridge (MARKET_DATA_PROVIDER=BRIDGE): quotes pushed by bridge/mt5_bridge.py from your own MetaTrader 5
# terminal. The push endpoint refuses everything unless this shared secret is set; use a long random value and
# set the same value where the bridge runs. Read-only: the bridge never calls an order function.
SPARKZ_BRIDGE_TOKEN=

# ---- Strategy (presets in config/presets/; env values override the preset) ----
EXECUTION_MODE=SIMULATION         # SIMULATION | MT5_DEMO (demo account, bridge --trade) | MT5_LIVE (real allowed, bridge --trade --live)
MAX_LIVE_LOTS=0.01                 # cap per order sent to MT5 (hard ceiling 0.1)
LIVE_DAILY_LOSS_PERCENT=3          # no new MT5 trade once MT5 equity is this % down on the UTC day
ASSISTANT_GATE=true                # market assistant must agree before a new basket opens (paper trading)
ASSISTANT_MIN_CONFIDENCE=0.55      # assistant confidence needed for BUY/SELL (0-1)
ASSISTANT_DECISION=VOTE            # VOTE (all strategies vote) or TOP_STRATEGY (follow the highest-ranked one)
ASSISTANT_TOP_STRATEGIES=1         # TOP_STRATEGY: how many of the top-ranked strategies may be followed
SPARKZ_PRESET=                     # e.g. assistant, atr_grid, video_style, baseline
VIDEO_STYLE_MODE=false             # true -> video_style preset (an approximation, not the video's algorithm)
GRID_MODE=ATR                      # FIXED | ATR | SIGNAL_CONFIRMED | NONE
GRID_DISTANCE=5.0
GRID_ATR_MULTIPLIER=0.5
POSITION_SIZE_MODE=FIXED           # FIXED | LINEAR | PYRAMID | MULTIPLIER (HIGH RISK)
BASE_LOT=0.01
ALLOW_MULTIPLIER_SIZING=false      # must be true for MULTIPLIER; HIGH RISK, research only
BASKET_TARGET_MODE=FIXED_PROFIT    # FIXED_PROFIT | PERCENT_EQUITY | ATR_TARGET | RISK_MULTIPLE
BASKET_TARGET=10

# ---- Risk limits ----
INITIAL_CAPITAL=10000
MAX_POSITIONS=5
MAX_BASKET_LOSS_PERCENT=2.0
MAX_BASKET_LOSS=                   # optional absolute USD cap
MAX_BASKET_DRAWDOWN=               # optional: stop adding beyond this floating loss (USD)
MAX_ACCOUNT_DRAWDOWN=20
MAX_EXPOSURE=10
MAX_MARGIN_USAGE=50
MAX_DAILY_LOSS_PERCENT=5
COOLDOWN=1
COOLDOWN_AFTER_LOSS=8

# ---- Simulated execution ----
SPREAD_MULTIPLIER=1.0
SLIPPAGE_MULTIPLIER=1.0
COMMISSION_PER_LOT_SIDE=0
EXECUTION_DELAY_MS=0
INTRABAR_ORDER=FAVOURABLE_FIRST    # backtest only: FAVOURABLE_FIRST | RANDOM | ADVERSE_FIRST

# ---- Storage / API ----
SPARKZ_V2_DATA_DIR=
SPARKZ_V2_REPORTS_DIR=
SPARKZ_V2_DB_URL=                  # default sqlite:///data/sparkz_v2.db
CORS_ORIGINS=http://localhost:5173

# MT5 sync (EXECUTION_MODE=MT5_DEMO / MT5_LIVE)
SYNC_MT5_BALANCE=true              # robot account starts from the MT5 balance
ADOPT_MT5_POSITIONS=true           # take over SPARKZ positions left open in MT5 (after a restart)
# Telegram alerts (never commit the token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Online: every dashboard request needs this password (leave empty on your own PC)
SPARKZ_DASHBOARD_PASSWORD=
CHART_ALERT_TFS=1h,4h,1d            # new BOS / CHoCH alerts on watched markets (off = none)
# MT5 bridge (bridge/mt5_bridge.py reads this file too; START_SPARKZ.bat / SETUP_SPARKZ.bat write it)
BRIDGE_SYMBOL=XAUUSDm                # gold's name in your MT5 Market Watch
BRIDGE_WATCH=EURUSDm,GBPUSDm,USDJPYm # more markets for the Chart page
BRIDGE_SERVER=http://127.0.0.1:8010
BRIDGE_TRADE=true                    # execute the robot's orders (demo; a real account still needs --live)
