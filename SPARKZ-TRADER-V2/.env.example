# SPARKZ TRADER V2 — example environment. Copy to .env and fill in locally. NEVER commit .env.
# Every value here is a placeholder; no real credential belongs in this file.

# ---- Safety (enforced: the app refuses to start with live trading enabled) ----
LIVE_TRADING_ENABLED=false
ENVIRONMENT=PAPER                  # DEVELOPMENT | BACKTEST | PAPER

# ---- Market data ----
MARKET_DATA_PROVIDER=MOCK          # MOCK | YAHOO | BROKER | HISTORICAL
SYMBOL=XAUUSD
TIMEFRAME=15m
POLL_SECONDS=5
STALE_AFTER_SECONDS=120

# Broker market data (OANDA v20, READ-ONLY: pricing, candles, instrument details; no orders).
# A practice-account token is enough. Leave empty unless MARKET_DATA_PROVIDER=BROKER.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice         # practice | live (still market data only)

# ---- Strategy (presets in config/presets/; env values override the preset) ----
SPARKZ_PRESET=                     # e.g. atr_grid, video_style, baseline
VIDEO_STYLE_MODE=false             # true -> video_style preset (an approximation, not the video's algorithm)
GRID_MODE=ATR                      # FIXED | ATR | SIGNAL_CONFIRMED | NONE
GRID_DISTANCE=5.0
GRID_ATR_MULTIPLIER=0.5
POSITION_SIZE_MODE=FIXED           # FIXED | LINEAR | PYRAMID | MULTIPLIER (HIGH RISK)
BASE_LOT=0.01
ALLOW_MULTIPLIER_SIZING=false      # must be true for MULTIPLIER; HIGH RISK, research only
BASKET_TARGET_MODE=FIXED_PROFIT    # FIXED_PROFIT | PERCENT_EQUITY | ATR_TARGET | RISK_MULTIPLE
BASKET_TARGET=10

# ---- Risk limits ----
INITIAL_CAPITAL=10000
MAX_POSITIONS=5
MAX_BASKET_LOSS_PERCENT=2.0
MAX_BASKET_LOSS=                   # optional absolute USD cap
MAX_BASKET_DRAWDOWN=               # optional: stop adding beyond this floating loss (USD)
MAX_ACCOUNT_DRAWDOWN=20
MAX_EXPOSURE=10
MAX_MARGIN_USAGE=50
MAX_DAILY_LOSS_PERCENT=5
COOLDOWN=1
COOLDOWN_AFTER_LOSS=8

# ---- Simulated execution ----
SPREAD_MULTIPLIER=1.0
SLIPPAGE_MULTIPLIER=1.0
COMMISSION_PER_LOT_SIDE=0
EXECUTION_DELAY_MS=0
INTRABAR_ORDER=FAVOURABLE_FIRST    # backtest only: FAVOURABLE_FIRST | RANDOM | ADVERSE_FIRST

# ---- Storage / API ----
SPARKZ_V2_DATA_DIR=
SPARKZ_V2_REPORTS_DIR=
SPARKZ_V2_DB_URL=                  # default sqlite:///data/sparkz_v2.db
CORS_ORIGINS=http://localhost:5173
