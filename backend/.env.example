# Copy this file to .env and adjust values. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

MARKET_SYMBOL=EURUSD=X
TIMEFRAME=1h

INITIAL_CAPITAL=10000
RISK_PER_TRADE=0.01
MAX_SIMULTANEOUS_POSITIONS=1
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.20
MAX_EXPOSURE_PCT=0.5
TRADING_COOLDOWN_BARS=0

STOP_ATR_MULTIPLIER=2
TAKE_PROFIT_R=2

RSI_PERIOD=14
RSI_BUY_THRESHOLD=50
RSI_SELL_THRESHOLD=50
EMA_FAST=20
EMA_SLOW=50
EMA_LONG=200
ATR_PERIOD=14

LOOKAHEAD_PERIOD=5
TARGET_RETURN_THRESHOLD=0.0005
TRAIN_FRACTION=0.70
VALIDATION_FRACTION=0.15
SIGNAL_BUY_THRESHOLD=0.60
SIGNAL_SELL_THRESHOLD=0.60

SPREAD_PIPS=1.2
SLIPPAGE_PIPS=0.3
COMMISSION_PER_TRADE=0.0
PIP_SIZE=0.0001

DATABASE_URL=sqlite:///./data/sparkz_trader.db

# Hard safety switch. Must be explicitly "true" for any future live-broker
# adapter to run. No such adapter exists in this build.
LIVE_TRADING_ENABLED=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
